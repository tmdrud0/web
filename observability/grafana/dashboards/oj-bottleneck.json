        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "contest_outbox_head_lag_seconds",
          "legendFormat": "{{outbox}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Drain and retry rate",
      "description": "Rows per second reaching a terminal state, against rows put back for another attempt. Only applied updates are counted: a claim whose lease had already expired changed no row and left the event in the backlog. A retry rate rising against a flat drain rate is a stuck pipeline rather than a slow one, and the two are indistinguishable from the backlog count alone.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outbox) (rate(contest_outbox_drained_total[$__rate_interval]))",
          "legendFormat": "{{outbox}} drained"
        },
        {
          "refId": "B",
          "expr": "sum by (outbox) (rate(contest_outbox_retries_total[$__rate_interval]))",
          "legendFormat": "{{outbox}} retried"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Estimated drain time",
      "description": "backlog / recent drain rate, the figure pipeline history 9.2 asks for: a queue depth on its own says nothing about whether a contest can wait for it. From the recording rule in observability/prometheus/rules/oj-pipeline.yml, which is also what the drain-time alert fires on. No line at all means the backlog is empty. A line pinned at the top means the backlog is not moving - the rule leaves that as +Inf on purpose rather than papering over a division by zero.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oj:contest_outbox_estimated_drain:seconds",
          "legendFormat": "{{outbox}}"
        }
      ]
    },
