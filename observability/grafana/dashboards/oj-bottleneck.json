{
  "uid": "oj-bottleneck",
  "title": "OJ - Bottleneck Overview",
  "description": "Where the submission pipeline is currently constrained. Ordered by the resource-ceiling-first reading order: container limits, then HTTP, then JVM, then DB, then broker.",
  "tags": ["oj", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Resource ceilings (compose limits)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU throttling (app tier)",
      "description": "Seconds of runnable time denied per second by the CFS quota, read from cgroup v2 inside each JVM because cAdvisor cannot label containers on Docker Desktop. Non-zero is the normal state here rather than a finding: README section 8 measured 61-78% of periods throttled on all instances at idle, and JVM startup is CPU-hungry by nature. What matters is whether the rate holds through a load run, because a run spent at the quota measured the CPU ceiling and not an application bottleneck.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(cgroup_cpu_throttled_time_seconds_total[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage / limit (app tier)",
      "description": "1.0 means the container is consuming its entire compose CPU allowance. Denominator is cpu.max, so it tracks the compose limit automatically.",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(cgroup_cpu_usage_seconds_total[$__rate_interval])) / sum by (node) (cgroup_cpu_limit_cores)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory usage / limit (app tier)",
      "description": "Working set is memory.current minus inactive_file, the definition cAdvisor, docker stats and kubelet all use. The subtracted page cache is what the kernel reclaims first, so counting it would hold any container doing file I/O near 1.0 regardless of load and never fall back. What is left still spans the whole cgroup rather than JVM heap alone: off-heap buffers, metaspace, thread stacks and whatever file cache the kernel has not reclaimed all land here.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (cgroup_memory_working_set_bytes) / sum by (node) (cgroup_memory_limit_bytes)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU throttling (infra, by cgroup id)",
      "description": "MySQL, Redis, RabbitMQ and nginx have no JVM to report from, so these come from cAdvisor. Docker Desktop's containerd image store stops cAdvisor resolving container names, so series are keyed by cgroup id. Resolve one with: docker inspect <id prefix>",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (id) (rate(container_cpu_cfs_throttled_seconds_total{id=~\"/docker/.+\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Throttled period ratio (app tier)",
      "description": "Share of CFS periods in which the container was denied runnable time. This is the number observability/README.md section 8 quotes (61-78% at idle on first boot), so it belongs on the dashboard rather than only in prose. Seconds-per-second next door says how much time was lost; this says how often it happened, which is the figure that stays comparable across containers with different quotas.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(cgroup_cpu_throttled_periods_total[$__rate_interval])) / sum by (node) (rate(cgroup_cpu_periods_total[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "OOM kills over the selected range (app tier)",
      "description": "Kernel OOM kills counted by the cgroup itself, from memory.events, so unlike the pressure gauges next door this is an event rather than an estimate. Its reach is narrow though: when the victim is the JVM the container ends with it, the increment lands after the last scrape and is never collected, and the replacement container counts from zero in a fresh cgroup. Only a kill of some other process in the cgroup shows up here. batch-1 in ENVIRONMENT.md 8.1 was the JVM case, so this panel would have stayed at zero throughout it. Non-zero invalidates the run it appears in; zero is not evidence that no OOM happened - read JVM restarts alongside it.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (increase(cgroup_memory_oom_kills_total[$__range]))",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "JVM restarts over the selected range (app tier)",
      "description": "Changes in process_start_time_seconds, one per restart. This is the signal that actually catches a JVM OOM here: the kill takes the container down before its own oom_kill increment can be scraped, so the restart is the only trace that survives. It does not say why the process restarted - a manual recreate counts too - but any non-zero value invalidates the run, because a JVM that restarted mid-measurement was not measuring the same thing on both sides of it.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (changes(process_start_time_seconds{job=\"oj-app\"}[$__range]))",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Submission HTTP (web role)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency percentiles (web-1 + web-2)",
      "description": "Computed from histogram buckets, so this is a true percentile over both instances combined. The perf snapshot API could only report per-JVM average and max.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{role=\"web\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{role=\"web\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{role=\"web\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by outcome",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{role=\"web\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backpressure responses (429 / 503)",
      "description": "429 is the per-user rate limit, 503 is the global admission ceiling (max-in-flight). Separating them is the point of pipeline history 9.2 - they mean different things and must not be read as one error rate.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{role=\"web\", status=~\"429|503\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap used",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC pause time per second",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "oj-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
